pipeline {

    // Run on the Jenkins agent with Terraform, Azure CLI, Ansible,
    // Trivy, Git, and the SonarQube Scanner available.
    agent any

    // Select whether to deploy or destroy the Azure environment.
    parameters {
        choice(
            name: 'ACTION',
            choices: ['APPLY', 'DESTROY'],
            description: 'Choose APPLY to deploy or DESTROY to remove the Azure AD lab environment.'
        )
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 4, unit: 'HOURS')
    }

    environment {

        // Terraform automation mode.
        TF_IN_AUTOMATION = 'true'

        // Shared Ansible virtual environment and required tools.
        PATH = "/opt/jenkins-tools/ansible/bin:/usr/local/bin:/usr/bin:/bin:${env.PATH}"

        // --------------------------------------------------
        // Azure service principal credentials
        // --------------------------------------------------

        // These variables are populated from Jenkins Credentials.
        ARM_CLIENT_ID       = credentials('azure_client_id')
        ARM_CLIENT_SECRET   = credentials('azure_client_secret')
        ARM_TENANT_ID       = credentials('azure-tenant-id')
        ARM_SUBSCRIPTION_ID = credentials('azure-subscription-id')

        // --------------------------------------------------
        // Terraform and Ansible credentials
        // --------------------------------------------------

        // Terraform Azure AD administrator password.
        TF_VAR_admin_password = credentials('azure-ad-admin-password')

        // Ansible Vault password file.
        ANSIBLE_VAULT_PASSWORD_FILE = credentials('ansible-vault-password-file')
    }

    stages {

        // --------------------------------------------------
        // 1. Checkout Azure AD Lab repository
        // --------------------------------------------------

        stage('SCM Checkout') {
            steps {
                checkout scm

                sh '''
                    set -e

                    echo "Azure Windows Server 2022 AD DS Pipeline"
                    echo "========================================"

                    echo "Selected action: $ACTION"

                    # Display the checked-out commit.
                    git log -1 --oneline

                    # Confirm the repository root.
                    pwd
                '''
            }
        }

        // --------------------------------------------------
        // 2. Validate prerequisites
        // --------------------------------------------------

        stage('Pre-deployment Checks') {
            steps {
                sh '''
                    set -e

                    echo "=========================================="
                    echo "Pipeline prerequisite validation"
                    echo "=========================================="

                    # Confirm the Azure Terraform configuration exists.
                    test -f azure-ad-lab-terraform/main.tf
                    test -f azure-ad-lab-terraform/versions.tf

                    # Confirm tools required for both operations.
                    for cmd in terraform az trivy git; do
                        command -v "$cmd" >/dev/null 2>&1 || {
                            echo "ERROR: Missing required command: $cmd"
                            exit 1
                        }
                    done

                    # Deployment-only tools are not required for DESTROY.
                    if [ "$ACTION" = "APPLY" ]; then

                        test -f startupadds-azure.sh
                        bash -n startupadds-azure.sh

                        for cmd in ansible-playbook ansible \
                                   ansible-inventory ansible-vault \
                                   ansible-galaxy python3; do

                            command -v "$cmd" >/dev/null 2>&1 || {
                                echo "ERROR: Missing deployment command: $cmd"
                                exit 1
                            }
                        done

                        # Verify the Ansible Vault credential is accessible.
                        test -r "$ANSIBLE_VAULT_PASSWORD_FILE"
                    fi

                    # Verify the shared Azure credentials are populated.
                    test -n "$ARM_CLIENT_ID"
                    test -n "$ARM_CLIENT_SECRET"
                    test -n "$ARM_TENANT_ID"
                    test -n "$ARM_SUBSCRIPTION_ID"

                    # Display installed tool versions.
                    terraform version
                    az version --output table
                    trivy version

                    if [ "$ACTION" = "APPLY" ]; then
                        ansible --version
                    fi

                    echo "All required tools are available."
                    echo "Pre-deployment validation passed."
                '''
            }
        }

        // --------------------------------------------------
        // 3. Trivy filesystem security scan
        // --------------------------------------------------

        stage('Trivy Scan') {
            steps {
                sh '''
                    set -e

                    echo "=========================================="
                    echo "Trivy filesystem security scan"
                    echo "=========================================="

                    # Scan dependencies and repository files for vulnerabilities
                    # and exposed secrets.
                    trivy fs \
                        --scanners vuln,secret \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        --format table \
                        --skip-dirs .git \
                        --skip-dirs .venv \
                        --skip-dirs logs \
                        --skip-dirs .terraform \
                        --skip-dirs .ansible \
                        .

                    echo "=========================================="
                    echo "Trivy Terraform IaC security scan"
                    echo "=========================================="

                    # Scan Terraform configuration for misconfigurations.
                    trivy config \
                        --misconfig-scanners terraform \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        --format table \
                        --skip-dirs .git \
                        --skip-dirs .venv \
                        --skip-dirs logs \
                        --skip-dirs .terraform \
                        --skip-dirs .ansible \
                        .

                    echo "Trivy security scans passed."
                '''
            }
        }

        // --------------------------------------------------
        // 4. SonarQube source-code and configuration analysis
        // --------------------------------------------------

        stage('SonarQube Analysis') {
            steps {
                script {

                    // Use the scanner installation configured in Jenkins.
                    def scannerHome = tool 'SonarScanner'

                    // Connect to the configured SonarQube server.
                    withSonarQubeEnv('SonarQube-Local') {

                        sh """
                            set -e

                            echo "Starting SonarQube analysis."

                            "${scannerHome}/bin/sonar-scanner" \
                                -Dsonar.projectKey=azure-windows-ad-lab \
                                -Dsonar.projectName="Azure Windows AD Lab" \
                                -Dsonar.projectVersion=1.0 \
                                -Dsonar.sources=. \
                                -Dsonar.sourceEncoding=UTF-8 \
                                -Dsonar.exclusions="**/.git/**,**/.venv/**,**/venv/**,**/.terraform/**,**/.ansible/**,**/logs/**,**/vault.yml,**/*.tfstate,**/*.tfstate.backup,**/*.tfplan,**/*.pem,**/*.key"

                            echo "SonarQube analysis submitted."
                        """
                    }
                }
            }
        }

        // --------------------------------------------------
        // 5. Wait for SonarQube Quality Gate
        // --------------------------------------------------

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {

                    // Stop the pipeline if the Quality Gate fails.
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // --------------------------------------------------
        // 6. APPLY: Manual deployment approval
        // --------------------------------------------------

        stage('Deployment Approval') {
            when {
                expression {
                    params.ACTION == 'APPLY'
                }
            }
            steps {
                script {

                    // Require approval before creating billable Azure resources.
                    input(
                        message: 'Approve deployment of the Windows Server 2022 AD DS infrastructure in Azure? This deployment may create billable resources.',
                        ok: 'Approve Azure Deployment'
                    )
                }
            }
        }

        // --------------------------------------------------
        // 7. APPLY: Deploy Azure infrastructure and configure AD DS
        // --------------------------------------------------

        stage('Deploy Azure ADDS') {
            when {
                expression {
                    params.ACTION == 'APPLY'
                }
            }
            steps {

                // Authenticate using the shared top-level credentials.
                sh '''
                    set +x
                    set -e

                    echo "=========================================="
                    echo "Validating Azure credentials"
                    echo "=========================================="

                    az login \
                        --service-principal \
                        --username "$ARM_CLIENT_ID" \
                        --password "$ARM_CLIENT_SECRET" \
                        --tenant "$ARM_TENANT_ID" \
                        --output none

                    # Select the Azure subscription.
                    az account set --subscription "$ARM_SUBSCRIPTION_ID"

                    # Display authenticated account information.
                    az account show \
                        --query "{subscription:name, subscriptionId:id, tenantId:tenantId}" \
                        --output table

                    # Confirm the Ansible Vault password file is accessible.
                    test -r "$ANSIBLE_VAULT_PASSWORD_FILE"

                    echo "Azure authentication and Vault validation passed."
                '''

                // The Jenkins approval stage has already been completed.
                withEnv(['JENKINS_AUTO_APPROVE=true']) {

                    sh '''
                        set +x
                        set -e

                        # Restrict access to the deployment script.
                        chmod 700 startupadds-azure.sh

                        echo "=========================================="
                        echo "Starting Azure Active Directory deployment"
                        echo "=========================================="

                        # Run the existing Azure deployment automation.
                        ./startupadds-azure.sh
                    '''
                }
            }
        }

        // --------------------------------------------------
        // 8. DESTROY: Generate Terraform destruction plan
        // --------------------------------------------------

        stage('Destroy Plan') {
            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }
            steps {

                // Authenticate to Azure before Terraform operations.
                sh '''
                    set +x
                    set -e

                    az login \
                        --service-principal \
                        --username "$ARM_CLIENT_ID" \
                        --password "$ARM_CLIENT_SECRET" \
                        --tenant "$ARM_TENANT_ID" \
                        --output none

                    az account set --subscription "$ARM_SUBSCRIPTION_ID"

                    echo "Authenticated to Azure subscription."
                '''

                dir('azure-ad-lab-terraform') {
                    sh '''
                        set +x
                        set -euo pipefail

                        echo "=========================================="
                        echo "Preparing Azure Terraform destruction plan"
                        echo "=========================================="

                        # Initialize the existing Terraform backend.
                        terraform init -input=false

                        # Display the selected Terraform workspace.
                        terraform workspace show

                        # Capture all resources currently tracked by Terraform.
                        STATE_RESOURCES="$(terraform state list)"

                        # Refuse to generate an empty destruction plan.
                        if [ -z "$STATE_RESOURCES" ]; then
                            echo "ERROR: Terraform state contains no managed resources."
                            echo "Refusing to generate an empty destruction plan."
                            exit 1
                        fi

                        # Display resources currently managed by Terraform.
                        echo "Terraform resources currently tracked:"
                        printf '%s\\n' "$STATE_RESOURCES"

                        # Generate a saved destruction plan without deleting resources.
                        terraform plan \
                            -destroy \
                            -input=false \
                            -lock-timeout=5m \
                            -out=destroy.tfplan

                        # Display the resources scheduled for destruction.
                        echo "=========================================="
                        echo "REVIEW THE FOLLOWING DESTRUCTION PLAN"
                        echo "=========================================="

                        terraform show -no-color destroy.tfplan

                        echo "=========================================="
                        echo "Destroy plan generated successfully."
                        echo "No Azure resources have been destroyed yet."
                        echo "=========================================="
                    '''
                }
            }
        }

        // --------------------------------------------------
        // 9. DESTROY: Manual destruction approval
        // --------------------------------------------------

        stage('Destroy Approval') {
            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }
            steps {
                script {

                    // Require explicit approval before removing Azure resources.
                    timeout(time: 15, unit: 'MINUTES') {
                        input(
                            message: 'WARNING: You are about to destroy the Azure Windows Server 2022 AD Lab environment. Review the Destroy Plan stage before approving.',
                            ok: 'Destroy Azure Environment'
                        )
                    }
                }
            }
        }

        // --------------------------------------------------
        // 10. DESTROY: Execute the approved Terraform plan
        // --------------------------------------------------

        stage('Destroy Azure Env') {
            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }
            steps {

                // Reauthenticate before executing the destruction plan.
                sh '''
                    set +x
                    set -e

                    az login \
                        --service-principal \
                        --username "$ARM_CLIENT_ID" \
                        --password "$ARM_CLIENT_SECRET" \
                        --tenant "$ARM_TENANT_ID" \
                        --output none

                    az account set --subscription "$ARM_SUBSCRIPTION_ID"

                    echo "Authenticated to Azure subscription."
                '''

                dir('azure-ad-lab-terraform') {
                    sh '''
                        set +x
                        set -euo pipefail

                        echo "=========================================="
                        echo "Destroying Azure Active Directory environment"
                        echo "=========================================="

                        # Ensure the approved destruction plan exists.
                        test -s destroy.tfplan

                        # Apply the exact destruction plan reviewed earlier.
                        terraform apply \
                            -input=false \
                            -lock-timeout=5m \
                            -auto-approve \
                            destroy.tfplan

                        echo "=========================================="
                        echo "Verifying Terraform destruction"
                        echo "=========================================="

                        # Capture the remaining Terraform state.
                        STATE_RESOURCES="$(terraform state list)"

                        # Fail if any managed resources remain.
                        if [ -n "$STATE_RESOURCES" ]; then
                            echo "ERROR: Terraform state still contains resources."
                            printf '%s\\n' "$STATE_RESOURCES"
                            exit 1
                        fi

                        echo "SUCCESS: Terraform state contains no managed resources."
                        echo "Azure infrastructure destruction completed."
                    '''
                }
            }
        }

        // --------------------------------------------------
        // 11. APPLY: Deployment completion
        // --------------------------------------------------

        stage('Deployment Summary') {
            when {
                expression {
                    params.ACTION == 'APPLY'
                }
            }
            steps {
                echo 'Azure Windows Server 2022 AD DS deployment completed successfully.'
                echo 'Trivy filesystem and Terraform security scans passed.'
                echo 'SonarQube Quality Gate passed.'
                echo 'Review deployment logs and Terraform outputs.'
            }
        }

        // --------------------------------------------------
        // 12. DESTROY: Completion summary
        // --------------------------------------------------

        stage('Destroy Summary') {
            when {
                expression {
                    params.ACTION == 'DESTROY'
                }
            }
            steps {
                echo 'Azure Active Directory infrastructure destruction completed successfully.'
                echo 'Terraform reports no remaining managed resources in this state.'
                echo 'Review the Azure portal to confirm resource cleanup.'
            }
        }
    }

    // --------------------------------------------------
    // Pipeline completion and failure handling
    // --------------------------------------------------

    post {

        success {
            script {
                if (params.ACTION == 'APPLY') {
                    echo 'SUCCESS: Azure Active Directory deployment completed.'
                } else {
                    echo 'SUCCESS: Azure Active Directory destruction completed.'
                }

                echo 'Trivy and SonarQube checks passed.'
            }
        }

        failure {
            echo 'FAILED: The selected Azure infrastructure operation encountered an error.'
            echo 'Review the Jenkins console output and identify the failed stage.'
        }

        aborted {
            echo 'The pipeline was aborted or the approval was declined.'
        }

        always {

            // Remove the saved destruction plan after the pipeline finishes.
            // Terraform plan files can contain sensitive infrastructure data.
            sh '''
                rm -f azure-ad-lab-terraform/destroy.tfplan
            '''

            echo 'Azure AD DS Jenkins pipeline execution finished.'
        }
    }
}
